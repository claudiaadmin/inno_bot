mixin header(title)
    header
        .header-inner
            h1= title
            nav
                a.nav-link(href="/") Home
                a.nav-link(href="/record") Record
                a.nav-link(href="/summary") Summary

mixin container
    .container
        block


mixin button(id, text, additional_class='')
    button(id=id, class=additional_class)= text