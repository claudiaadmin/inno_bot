extends layout

include mixins.pug

block content
    +header('Feedback Bot')

    .container.cover-container
        .hero-icon
            svg(xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
                circle(cx="12" cy="12" r="10")
                line(x1="12" y1="16" x2="12" y2="12")
                line(x1="12" y1="8" x2="12.01" y2="8")
        h2.section-title Welcome
        p.description We value your honest thoughts about the workshop. Your feedback helps us improve future sessions.
        .notice-card
            h3 Before You Begin
            ul
                li Your participation is entirely <strong>voluntary</strong>.
                li You may choose to remain <strong>anonymous</strong> or select a group.
                li All feedback is used solely for improving our workshops.
                li You can stop recording at any time.
        a.start-button(href="/record")
            svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                path(d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z")
                path(d="M19 10v2a7 7 0 0 1-14 0v-2")
                line(x1="12" y1="19" x2="12" y2="23")
                line(x1="8" y1="23" x2="16" y2="23")
            span Start Recording
