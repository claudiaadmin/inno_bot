extends layout

include mixins.pug

block content
    +header('Feedback Bot')

    .container
        #recordingArea
            .hero-icon
                svg(xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
                    path(d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z")
                    path(d="M19 10v2a7 7 0 0 1-14 0v-2")
                    line(x1="12" y1="19" x2="12" y2="23")
                    line(x1="8" y1="23" x2="16" y2="23")
            h2.section-title Share Your Feedback
            p.description Share your feedback about the workshop by recording your voice or typing it out.
            .name-input-group
                label(for="usernameInput") Your Group
                select#usernameInput
                    option(value="Anonymous") Anonymous
                    option(value="Group 1") Group 1
                    option(value="Group 2") Group 2
                    option(value="Group 3") Group 3
                    option(value="Group 4") Group 4
                    option(value="Group 5") Group 5
            .input-mode-tabs
                button.mode-tab.active#tabRecord
                    svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        path(d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z")
                        path(d="M19 10v2a7 7 0 0 1-14 0v-2")
                    span Record
                button.mode-tab#tabType
                    svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        polyline(points="4 7 4 4 20 4 20 7")
                        line(x1="9" y1="20" x2="15" y2="20")
                        line(x1="12" y1="4" x2="12" y2="20")
                    span Type

            .mode-panel#panelRecord
                .record-wrapper
                    .pulse-ring#pulseRing
                    button#recordButton
                        span.record-dot
                        span.record-label Start Recording
                p#status Press the button to begin recording.

            .mode-panel.hidden#panelType
                .text-input-group
                    label(for="feedbackText") Your Feedback
                    textarea#feedbackText(rows="5" placeholder="Type your feedback here...")
                button.action-btn.action-btn--primary#submitTextButton
                    svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        line(x1="22" y1="2" x2="11" y2="13")
                        polygon(points="22 2 15 22 11 13 2 9 22 2")
                    span Submit Feedback

            .transcription-section#transcriptionSection
                h3 Your Feedback
                pre#transcription
                .action-buttons#actionButtons
                    button.action-btn.action-btn--icon#undoButton(title="Undo — remove this feedback")
                        svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            polyline(points="1 4 1 10 7 10")
                            path(d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10")
                        span Undo
                    button.action-btn.action-btn--icon.hidden#redoButton(title="Redo — re-submit undone feedback")
                        svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            polyline(points="23 4 23 10 17 10")
                            path(d="M20.49 15a9 9 0 1 1-2.13-9.36L23 10")
                        span Redo
                    button.action-btn.action-btn--secondary#startOverButton
                        svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            polyline(points="23 4 23 10 17 10")
                            path(d="M20.49 15a9 9 0 1 1-2.13-9.36L23 10")
                        span Start Over
                    button.action-btn.action-btn--primary#doneButton
                        svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            polyline(points="20 6 9 17 4 12")
                        span Done

        .done-screen#doneScreen
            .hero-icon.hero-icon--success
                svg(xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
                    path(d="M22 11.08V12a10 10 0 1 1-5.93-9.14")
                    polyline(points="22 4 12 14.01 9 11.01")
            h2.section-title Thank You!
            p.description Your feedback has been recorded successfully. It will help us improve future workshops.
            .done-actions
                button.action-btn.action-btn--secondary#addMoreButton
                    svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        line(x1="12" y1="5" x2="12" y2="19")
                        line(x1="5" y1="12" x2="19" y2="12")
                    span Add More Feedback
                a.action-btn.action-btn--primary(href="/summary")
                    svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        path(d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z")
                        polyline(points="14 2 14 8 20 8")
                    span View Summary
