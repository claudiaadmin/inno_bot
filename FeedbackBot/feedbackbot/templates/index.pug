extends layout

include mixins.pug

block content
    +header('Feedback Bot')

    .container
        //- Feedback button which records and fetches the transcription.
        p Please provide your feedback about the workshop by stating your thoughts.
        button#recordButton Start
        p#status Please press start to begin.

        p Transcription:
        pre#transcription
